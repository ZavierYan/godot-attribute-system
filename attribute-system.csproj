<Project Sdk="Godot.NET.Sdk/4.7.2">

  <!-- Godot 主工程：插件源码归插件工程（ProjectReference 引用）；测试源码物理位于 tests/，
       但必须编译进本程序集——gdUnit4 编辑器面板只扫描主程序集发现 C# 测试；
       addons/gdUnit4 的 C# 桥接包装类同理必须留在主程序集编译。 -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'android' ">net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>attributesystem</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="addons/attribute-system/AttributeSystem.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="gdUnit4.api" Version="5.1.0-rc6" />
    <PackageReference Include="gdUnit4.test.adapter" Version="3.2.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- 排除插件源码（由插件工程编译），但保留 gdUnit4 桥接类；tests/ 源码经隐式通配编入本程序集 -->
    <Compile Remove="addons/**/*.cs" />
    <Compile Include="addons/gdUnit4/src/dotnet/*.cs" />
  </ItemGroup>

</Project>
