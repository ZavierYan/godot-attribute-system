<Project Sdk="Godot.NET.Sdk/4.6.3">

  <!-- Godot 主工程（壳）：本仓库无游戏代码，仅作为宿主样例引用插件工程并承载 Godot 工程配置；
       插件本体在 addons/attribute-system/AttributeSystem.csproj，测试在 tests/AttributeSystem.Tests.csproj。 -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'android' ">net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>attributesystem</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="addons/attribute-system/AttributeSystem.csproj" />
  </ItemGroup>
  <!-- 主程序集不含任何手写源码：插件源码归插件工程、测试源码归测试工程 -->
  <ItemGroup>
    <Compile Remove="addons/**/*.cs" />
    <Compile Remove="tests/**/*.cs" />
  </ItemGroup>

</Project>
